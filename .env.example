# Copy to .env and fill in real values. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3
EMAIL_HOST_USER=yourapp@gmail.com
EMAIL_HOST_PASSWORD=
# Put your Gmail app password above (Google 2-Step Verification required).
ANTHROPIC_API_KEY=
# Optional: use an Anthropic-compatible provider instead of api.anthropic.com.
# Example - AshnaAI:  ANTHROPIC_BASE_URL=https://api.ashna.ai/v1/api
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5
# --- or use Google Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey then set LLM_PROVIDER=gemini.
LLM_PROVIDER=anthropic
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL= Gemini 3.8 Flash
# Skills named in the JD may be added to the tailored resume even if missing from yours
ALLOW_JD_SKILLS=True
DAILY_SEND_LIMIT=20
# To really send emails while DEBUG=True: set EMAIL_HOST_USER + a Gmail app password
# (needs Google 2-Step Verification), then uncomment the line below:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# If your network gives "network is unreachable" errors for Gmail, prefer IPv4 with:
# EMAIL_BACKEND=config.email_backend.IPv4SMTPBackend
# If your network blocks port 587, switch to Gmail's other port (uncomment all three):
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
